# LPAREPORTS API — Light Peace Academy, Rwanda (Main and Rulindo campuses)

# MongoDB Atlas connection string, including the database name.
# MONGO_URI and DATABASE_URL are accepted as aliases.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/lpareports?retryWrites=true&w=majority"

# Long random string used to sign JWTs (use a strong value in production)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Comma separated list of allowed front-end origins, e.g. your Vercel domain
CLIENT_ORIGINS="https://your-app.vercel.app"

# Server port (Render sets PORT automatically)
PORT=5000

# Set to "production" on Render
NODE_ENV=production
