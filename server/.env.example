# LPAREPORTS API — Light Peace Academy, Rwanda (Main and Rulindo campuses)

# MySQL connection string created in cPanel. Use the real host name when the
# application runs on a different server (localhost only works on the host).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Long random string used to sign JWTs (use a strong value in production)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Comma separated list of allowed front-end origins
CLIENT_ORIGINS="http://localhost:5173"

# Server port
PORT=5000

# Set to "production" on Render
NODE_ENV=development

# Optional: public URL of the school logo (defaults to the bundled LPAREPORTS asset)
# SCHOOL_LOGO_URL=""
