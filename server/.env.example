# MongoDB Atlas connection string (include the database name)
# MONGO_URI and DATABASE_URL are also accepted as aliases.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/lpacamis?retryWrites=true&w=majority"

# Long random string used to sign JWTs (use a strong value in production)
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Comma separated list of allowed front-end origins
CLIENT_ORIGINS="http://localhost:5173"

# Server port
PORT=5000

# Set to "production" on Render
NODE_ENV=development

# Optional: public URL of the school logo (defaults to bundled asset)
# SCHOOL_LOGO_URL=""
