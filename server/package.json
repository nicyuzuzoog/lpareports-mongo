{
  "name": "lpacamis-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LPACAMIS API - authentication, assessments, report cards, approvals, audit trail.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
