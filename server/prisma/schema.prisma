// LPAREPORTS data model — MySQL via Prisma.
// relationMode = "prisma" emulates relations in the client instead of creating
// real foreign keys. That keeps cPanel/MySQL happy and makes seeding simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                    String          @id
  campusId              String
  name                  String
  email                 String
  phone                 String?
  passwordHash          String
  role                  String
  isActive              Boolean         @default(true)
  canDelete             Boolean         @default(false)
  isGlobal              Boolean         @default(false)
  classTeacherClassId   String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  classes               TeacherClass[]
  subjects              TeacherSubject[]
  assignedClasses       SchoolClass[]   @relation("ClassTeacher")
  createdStudents       Student[]
  submittedReports      ReportCard[]    @relation("SubmittedReports")
  approvedReports       ReportCard[]    @relation("ApprovedReports")
  createdReports        ReportCard[]    @relation("CreatedReports")
  taughtMarks           Mark[]

  @@unique([campusId, email])
  @@index([campusId, role])
  @@index([campusId, isGlobal])
}

model TeacherClass {
  id       String @id
  campusId String
  userId   String
  classId  String

  user  User        @relation(fields: [userId], references: [id])
  class SchoolClass @relation(fields: [classId], references: [id])

  @@unique([campusId, userId, classId])
}

model TeacherSubject {
  id        String @id
  campusId  String
  userId    String
  subjectId String

  user    User    @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([campusId, userId, subjectId])
}

model SchoolClass {
  id             String   @id
  campusId       String
  name           String
  level          String
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students       Student[]
  reportCards    ReportCard[]
  classTeacher   User?           @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  teacherClasses TeacherClass[]

  @@unique([campusId, name])
  @@index([campusId, level])
}

model Subject {
  id        String   @id
  campusId  String
  name      String
  code      String
  levels    Json
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marks          Mark[]
  teacherSubjects TeacherSubject[]

  @@unique([campusId, code])
  @@unique([campusId, name])
}

model Student {
  id            String    @id
  campusId      String
  code          String
  firstName     String
  lastName      String
  otherNames    String?
  gender        String
  dateOfBirth   DateTime?
  guardianName  String?
  guardianPhone String?
  address       String?
  isActive      Boolean   @default(true)
  classId       String
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reportCards ReportCard[]
  class       SchoolClass @relation(fields: [classId], references: [id])
  creator     User?       @relation(fields: [createdById], references: [id])

  @@unique([campusId, code])
  @@index([campusId, classId])
  @@index([campusId, lastName, firstName])
}

/// A report card. `term` is TERM1 / TERM2 / TERM3 / ANNUAL and
/// `type` is MIDTERM / TERM / ANNUAL.
model ReportCard {
  id            String    @id
  campusId      String
  studentId     String
  classId       String
  term          String
  type          String    @default("TERM")
  year          Int
  studentName   String    @default("")
  status        String    @default("DRAFT")
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  teacherComment String?
  dosComment    String?
  headComment   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student     Student  @relation(fields: [studentId], references: [id])
  class       SchoolClass @relation(fields: [classId], references: [id])
  marks       Mark[]
  submittedBy User?    @relation("SubmittedReports", fields: [submittedById], references: [id])
  approvedBy  User?    @relation("ApprovedReports", fields: [approvedById], references: [id])
  createdBy   User?    @relation("CreatedReports", fields: [createdById], references: [id])

  @@unique([campusId, studentId, term, year, type])
  @@index([campusId, classId, term, year])
  @@index([campusId, status])
}

model Mark {
  id           String   @id
  campusId     String
  reportCardId String
  subjectId    String
  caScore      Float?
  midtermScore Float?
  examScore    Float?
  total        Float?
  grade        String?
  remark       String?
  competency   String?
  teacherId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportCard ReportCard @relation(fields: [reportCardId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  teacher    User?      @relation(fields: [teacherId], references: [id])

  @@unique([campusId, reportCardId, subjectId])
  @@index([campusId, subjectId])
}

/// One settings row per campus; the id is the campus id.
model Setting {
  id                       String   @id
  schoolName               String
  schoolMotto              String
  schoolAddress            String
  schoolPhone              String
  schoolEmail              String
  headTeacherName          String
  dosName                  String
  gradingScales            Json
  passMark                 Float
  lowPerformanceThreshold  Float
  lowPerformanceMinSubjects Int
  courseworkWeight         Float
  examWeight               Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Global switches; seeded with a single row whose id is "GLOBAL".
model SystemSetting {
  id                          String   @id
  studentRegistrationEnabled   Boolean  @default(true)
  loginDisabledExceptSuperAdmin Boolean @default(false)
  updatedAt                   DateTime @updatedAt
}

model AuditLog {
  id          String   @id
  campusId    String
  userId      String?
  userName    String
  userRole    String
  action      String
  entity      String
  entityId    String?
  description String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([campusId, createdAt])
  @@index([campusId, entity])
}
